# QuorumLimiter environment configuration (EXAMPLE — placeholders only).
#
# Copy to .env and fill in real values for local development. The real .env is
# git-ignored and must never be committed. Generate the four secrets with, e.g.:
#
#   QL_CLUSTER_TOKEN="$(openssl rand -base64 36 | tr -d '\n')"
#   QL_ADMIN_TOKEN="$(openssl rand -base64 36 | tr -d '\n')"
#   QL_SESSION_KEY="$(openssl rand -base64 48 | tr -d '\n')"
#   QL_API_KEY_PEPPER="$(openssl rand -base64 48 | tr -d '\n')"
#
# The four secrets are shared identically across all three nodes. Everything
# under "Per-node settings" differs per node.

# --- Shared secrets (same on every node) ---
QL_CLUSTER_TOKEN=REPLACE_WITH_BASE64_SECRET
QL_ADMIN_TOKEN=REPLACE_WITH_BASE64_SECRET
QL_SESSION_KEY=REPLACE_WITH_BASE64_SECRET_MIN_32_BYTES
QL_API_KEY_PEPPER=REPLACE_WITH_BASE64_SECRET_MIN_32_BYTES

# --- Shared cluster settings ---
QL_CLUSTER_ID=quorumlimiter-local
QL_PEERS=node1=http://127.0.0.1:18081,node2=http://127.0.0.1:18082,node3=http://127.0.0.1:18083
QL_ELECTION_TIMEOUT_MIN=800ms
QL_ELECTION_TIMEOUT_MAX=1400ms
QL_HEARTBEAT_INTERVAL=200ms
QL_PROPOSAL_TIMEOUT=3s
QL_PUBLIC_BASE_URL=http://localhost:8080
QL_PRODUCTION=false
QL_LOG_LEVEL=info
# Development only: reveal full subjects in the audit UI. Keep false in production.
QL_REVEAL_SUBJECTS=false

# --- Per-node settings (change these per node) ---
QL_NODE_ID=node1
QL_BIND_ADDR=127.0.0.1:18081
QL_ADVERTISE_URL=http://127.0.0.1:18081
QL_DATA_PATH=./data/node1/quorumlimiter.db
