# Shared secrets for the local Docker Compose cluster (deploy/compose.dev.yml).
# Copy to deploy/.env and fill in real values. The real .env is git-ignored.
# Generate each secret independently, e.g.:
#   QL_CLUSTER_TOKEN="$(openssl rand -base64 36 | tr -d '\n')"
#   QL_ADMIN_TOKEN="$(openssl rand -base64 36 | tr -d '\n')"
#   QL_SESSION_KEY="$(openssl rand -base64 48 | tr -d '\n')"
#   QL_API_KEY_PEPPER="$(openssl rand -base64 48 | tr -d '\n')"
QL_CLUSTER_TOKEN=REPLACE_WITH_BASE64_SECRET
QL_ADMIN_TOKEN=REPLACE_WITH_BASE64_SECRET
QL_SESSION_KEY=REPLACE_WITH_BASE64_SECRET_MIN_32_BYTES
QL_API_KEY_PEPPER=REPLACE_WITH_BASE64_SECRET_MIN_32_BYTES
